# Copy to .env and fill in what you use. Everything is optional; the app runs offline without it.

# Live generation and LLM-as-judge scoring. Set ONE of these:
#   Google Gemini, free tier: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
#   OpenAI (paid): key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# If both keys are set, Gemini is used unless you set LLM_PROVIDER=openai
LLM_PROVIDER=

# Live queries against a Databricks SQL warehouse (also: pip install databricks-sql-connector)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
